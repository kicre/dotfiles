theme = "penumbra-light" # 设置主题

[editor]
line-number = "relative" # 相对行号
# cursorline = true # 高亮显示行
# cursorcolumn = true # 高亮显示列
default-line-ending = "native" # 行末换行符

[editor.statusline]
left = ["mode", "spinner", "read-only-indicator", "file-modification-indicator"]
center = ["file-base-name"]
right = ["diagnostics", "position", "position-percentage", "file-encoding", "file-line-ending", "file-type"]
separator = "│"
mode.normal = " "
mode.insert = "󰏪 "
mode.select = " "

[editor.lsp]
display-messages = true
auto-signature-help = true
display-signature-help-docs = true

[editor.cursor-shape]
insert = "bar"
normal = "underline"
select = "block"

[editor.whitespace]
render = "all"
[editor.whitespace.characters]
space = " "
nbsp = "⍽"
tab = "→"
newline = "⏎"
tabpad = "·" # tab空格会显示： "→···" (依赖于tab宽度)

[editor.indent-guides]
render = true
character = "╎" # 一些工作正常的符号: "▏", "┆", "┊", "⸽"
skip-levels = 1

[editor.gutters]
layout = ["diff", "diagnostics", "line-numbers", "spacer"]

[editor.soft-wrap]
enable = true
max-wrap = 25 # 增加该值可以降低强制从一个词中间软换行
max-indent-retain = 0
wrap-indicator = ""  # 设置后可以不现实软换行符号
wrap-at-text-width = false

[keys.normal]
C-g = [":new", ":insert-output lazygit", ":buffer-close!", ":redraw"]
{{- if (and (eq .chezmoi.os "linux") (ne .chezmoi.username "root")) }}
"i" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "insert_mode"]
"a" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "append_mode"]
"c" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "change_selection"]
"A-c" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "change_selection_noyank"]
"o" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "open_below"]
"I" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "insert_at_line_start"]
"A" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "insert_at_line_end"]
"O" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" enter >/dev/null 2>&1; fi", "open_above"]

[keys.insert]
"esc" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" exit >/dev/null 2>&1; fi", "normal_mode"]
"C-c" = [":sh if [ -x \"$HOME/.config/scripts/rime-ctl.sh\" ]; then \"$HOME/.config/scripts/rime-ctl.sh\" exit >/dev/null 2>&1; fi", "normal_mode"]
{{- else if eq .chezmoi.os "windows" }}
[keys.insert]
"esc" = [":sh if exist \"%APPDATA%\\helix\\rime-ctl.cmd\" \"%APPDATA%\\helix\\rime-ctl.cmd\" exit >nul 2>nul", "normal_mode"]
"C-c" = [":sh if exist \"%APPDATA%\\helix\\rime-ctl.cmd\" \"%APPDATA%\\helix\\rime-ctl.cmd\" exit >nul 2>nul", "normal_mode"]
{{- end }}
