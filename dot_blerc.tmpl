# ble.sh 用户配置（~/.blerc）
# 文档：https://github.com/akinomyoga/ble.sh/wiki

# ── 配色 ──
# 自定义方案在 ~/.config/blesh/contrib/scheme/base16_nobg.bash。
# 它继承官方 base16，颜色名全部映射到终端 0-15 调色板，
# 实际 RGB 仍由 Ghostty 的 Penumbra light/dark 主题决定。
bleopt import_path="$HOME/.config/blesh/contrib:${XDG_DATA_HOME:-$HOME/.local/share}/blesh/local"
bleopt color_scheme=base16_nobg

# ── 高亮 ──
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1

# ── 自动补全 / 历史建议 ──
bleopt complete_auto_complete=1
bleopt complete_auto_history=1
bleopt complete_auto_delay=150
# 关闭基于 LS_COLORS 的候选类型着色，避免绿色/亮蓝等与主题冲突；
# 只保留匹配文本高亮和选中项的前景色修饰。
bleopt complete_menu_color=
bleopt complete_menu_color_match=on
# 默认 align-nowrap；如果希望候选带描述，可改成 desc
# bleopt complete_menu_style=desc

# ── 历史记录 ──
bleopt history_share=1
bleopt history_erasedups_limit=1000

# Ctrl-D 时不再显示 [ble: EOF]
bleopt prompt_eol_mark=''

# ── bash-completion 集成 ──
# 由 chezmoi 下载到 ~/.config/bash/plugins/bash-completion，无需系统包。
# 必须在使用 fzf-completion 之前加载。
export BASH_COMPLETION_USER_DIR="$HOME/.config/bash/plugins/bash-completion"
_ble_bash_completion_file="$BASH_COMPLETION_USER_DIR/bash_completion"
if [[ -f $_ble_bash_completion_file ]]; then
  source -- "$_ble_bash_completion_file"
  ble-import -d integration/bash-completion
fi
unset -v _ble_bash_completion_file

# ── fzf 集成 ──
# ble.sh 下必须使用 blesh-contrib 的集成，不能用 eval "$(fzf --bash)"
if hash fzf 2>/dev/null; then
  ble-import -d integration/fzf-completion
  ble-import -d integration/fzf-key-bindings
fi

# ── zoxide 集成 ──
# 由 blesh-contrib 负责初始化 zoxide，并修正其补全在 ble.sh 下的行为。
if hash zoxide 2>/dev/null; then
  ble-import -d integration/zoxide
fi
