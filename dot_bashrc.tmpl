# ── Bash 基础设置 ──
# 历史记录：忽略连续重复/空格开头，并去重（对齐 zsh 的 HIST_IGNORE_*）
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=100000
HISTFILESIZE=100000
shopt -s histappend checkwinsize dirspell globstar extglob

set -o vi

if [[ $- == *i* ]] && command -v zsh >/dev/null 2>&1; then
  exec zsh -l
fi

{{ template "shrc.sh" . }}
